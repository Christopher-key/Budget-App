{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "lib": ["ES2022", "DOM"], "types": ["node"],
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["*.ts", "test/*.ts"]
}
