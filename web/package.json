  "dependencies": { "react": "19.3.1", "react-dom": "19.3.1" },
  "devDependencies": {
    "@types/node": "^24.0.0", "@types/react": "19.3.0", "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2", "typescript": "~7.0.2", "tsx": "4.23.15"
  },
  "engines": { "node": ">=22.12" }
}
