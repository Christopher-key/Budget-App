APP_ORIGIN=https://YOUR-STATIC-SITE.azurestaticapps.net
# Generate TWO INDEPENDENT random 32-byte base64url values in your own environment.
# These server secrets must stay in Azure app settings/Key Vault, never Git or chat.
AUTH_LOOKUP_KEY=
AUTH_PEPPER=
COSMOS_ENDPOINT=https://YOUR-ACCOUNT.documents.azure.com:443/
DATABASE_NAME=budget
CONTAINER_NAME=accounts
# Azure hosting: Function App's system-assigned managed identity, no database keys.
